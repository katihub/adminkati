{
  "name": "katihub-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:local": "env -u BACKEND_URL -u NUXT_API_BASE_URL nuxt dev --port=3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:check": "node scripts/check-translations.mjs && node scripts/check-translation-keys.mjs",
    "fallow": "fallow audit",
    "fallow:dead": "fallow dead-code",
    "fallow:health": "fallow health",
    "fallow:dupes": "fallow dupes",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "prepare": "husky"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.39.1",
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/ph": "^1.2.2",
    "@internationalized/date": "3.12.3",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@pinia/nuxt": "1.0.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/vue-query": "^5.102.8",
    "@unovis/ts": "1.6.7",
    "@unovis/vue": "1.6.7",
    "@vercel/analytics": "2.0.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.2.0",
    "dayjs-nuxt": "2.1.11",
    "evlog": "2.27.1",
    "h3": "^1.15.11",
    "motion-v": "^2.5.1",
    "nuxt": "^4.5.2",
    "nuxt-charts": "^2.2.1",
    "nuxt-freeform": "1.0.0",
    "nuxt-headlessui": "1.2.2",
    "nuxt-lottie": "1.0.9",
    "nuxt-security": "2.6.0",
    "nuxt-seo-utils": "8.4.3",
    "nuxt-ssr-api-logger": "2.0.3",
    "nuxt-zod": "1.5.0",
    "nuxt-zod-i18n": "1.12.1",
    "openai": "^7.27.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.4.11",
    "cookie-es": "^3.1.1",
    "fallow": "3.19.0",
    "happy-dom": "^20.11.6",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,cjs,vue}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,yml,yaml,toml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
