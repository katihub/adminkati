# Origines des services partagées par l'interface d'administration locale et le backend.
SUPABASE_URL=https://your-supabase.example.com
BACKEND_URL=http://localhost:3001

# Clé anonyme publique Supabase. Elle est distincte de toute clé serveur ou service-role.
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Gardez ce secret hors du contrôle de version. Générez-le avec : openssl rand -hex 32
# Il doit contenir au moins 32 caractères.
NUXT_SESSION_PASSWORD=replace-with-a-random-session-secret-of-at-least-32-characters

# Réutilisez les valeurs partagées ci-dessus pour la configuration d'exécution serveur de Nuxt.
NUXT_SUPABASE_URL=${SUPABASE_URL}
NUXT_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NUXT_API_BASE_URL=${BACKEND_URL}

# Paramètre d'authentification réservé au développement local. Ne l'activez pas en production.
NUXT_LOCAL_AUTH_BYPASS=true

# Origine qui héberge les images des produits du catalogue.
NUXT_PUBLIC_CATALOGUE_IMAGE_ORIGIN=https://your-catalogue-images.example.com

# Clé publiable Logo.dev (pk_) facultative pour les aperçus de logo de marque des produits.
# Cette valeur est exposée au navigateur ; n'utilisez jamais de clé secrète Logo.dev (sk_) ici.
NUXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# Clé d'API OpenAI réservée au serveur et utilisée pour la génération de contenu produit par IA.
# Obligatoire en production ; laissez-la vide en local si la génération n'est pas nécessaire.
NUXT_OPENAI_API_KEY=

# Modèle OpenAI utilisé pour la génération de contenu produit.
NUXT_AI_PRODUCT_COPY_MODEL=gpt-5.6-luna

# Origine publique de la boutique utilisée pour les liens vers les pages produit. N'ajoutez pas de chemin final.
NUXT_PUBLIC_STOREFRONT_URL=
